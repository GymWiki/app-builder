{
  "id": "android_signing",
  "naam": "integrations.android_signing.name",
  "categorie": "stores",
  "beschrijving": "integrations.android_signing.desc",
  "icoon": "key",
  "scope": "project",
  "velden": [
    {
      "id": "keystore",
      "label": "integrations.android_signing.fields.keystore.label",
      "type": "file",
      "geheim": true,
      "verplicht": true,
      "scope": "project",
      "validatie": {
        "bestandstype": ["jks", "keystore", "p12", "pfx"]
      },
      "hulptekst": "integrations.android_signing.fields.keystore.help",
      "guideId": null,
      "envVar": "STUDIO_KEYSTORE_PATH"
    },
    {
      "id": "alias",
      "label": "integrations.android_signing.fields.alias.label",
      "type": "text",
      "geheim": false,
      "verplicht": true,
      "scope": "project",
      "validatie": {
        "regex": "^[A-Za-z0-9._-]{1,64}$"
      },
      "hulptekst": "integrations.android_signing.fields.alias.help",
      "guideId": null,
      "envVar": "STUDIO_KEY_ALIAS",
      "standaard": "upload"
    },
    {
      "id": "keystore_password",
      "label": "integrations.android_signing.fields.keystore_password.label",
      "type": "password",
      "geheim": true,
      "verplicht": true,
      "scope": "project",
      "validatie": {
        "minLengte": 6
      },
      "hulptekst": "integrations.android_signing.fields.keystore_password.help",
      "guideId": null,
      "envVar": "STUDIO_KEYSTORE_PASSWORD"
    },
    {
      "id": "key_password",
      "label": "integrations.android_signing.fields.key_password.label",
      "type": "password",
      "geheim": true,
      "verplicht": false,
      "scope": "project",
      "validatie": {
        "minLengte": 6
      },
      "hulptekst": "integrations.android_signing.fields.key_password.help",
      "guideId": null,
      "envVar": "STUDIO_KEY_PASSWORD"
    }
  ],
  "checklistItems": ["accounts_signing"],
  "acties": ["keystore_genereren"]
}
